# فقط برای اولین گواهی (deploy/setup.sh مرحله ۵): گواهی هنوز نیست ولی چالش
# HTTP-01 به nginx روی پورت ۸۰ نیاز دارد. بعد از گرفتن گواهی NGINX_MODE=ssl.
server {
    listen 80;
    server_name ${DOMAIN_API} ${DOMAIN_ADMIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { default_type text/plain; return 200 "arbyte — SSL bootstrap\n"; }
}
