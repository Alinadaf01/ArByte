# ─────────────────────────────────────────────────────────────────────────────
# آربایت — متغیرهای تولیدی سرور ایران (api + admin + Celery).
# deploy/setup.sh مرحله ۳ این فایل را به .env.production کپی و secretها را
# تصادفی پر می‌کند. .env.production هرگز در git نمی‌رود (chmod 600).
# راهنمای کامل: docs/DEPLOY.md
# ─────────────────────────────────────────────────────────────────────────────

# ── دامنه‌ها ────────────────────────────────────────────────────────────────
# دامنه‌ی API و پنل (DNS هر دو → IP این سرور). فروشگاه روی Vercel است.
DOMAIN_API=api.arbyte.ir
DOMAIN_ADMIN=admin.arbyte.ir
# ایمیل Let's Encrypt (هشدار انقضای گواهی).
CERTBOT_EMAIL=admin@arbyte.ir

# ── ایمیج‌ها (docs/DEPLOY.md §۲) ──────────────────────────────────────────────
# Production images are published to ghcr.io/alinadaf01 by build-images.yml. Offline archives retain the same qualified image names.
IMAGE_REGISTRY=ghcr.io/alinadaf01
# Set this to the immutable GitHub commit SHA for the release.
IMAGE_TAG=REPLACE_WITH_GITHUB_COMMIT_SHA
# فقط اگر ایمیج خصوصی است: توکن فقط-خواندنی Docker Hub.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
# تصادفی، حداقل ۵۰ کاراکتر (setup.sh می‌سازد).
SECRET_KEY=
# امضای JWT مشتری/ادمین؛ جدا از SECRET_KEY (setup.sh می‌سازد).
JWT_SIGNING_KEY=
# کلید Fernet برای رمزکردن کلیدهای API در دیتابیس (کلیدهای درگاه/کاوه‌نگار).
# ⚠️ یک نسخه بیرون از سرور نگه دارید؛ گم شود = همه‌ی کلیدهای پنل غیرقابل‌خواندن.
FIELD_ENCRYPTION_KEY=
ALLOWED_HOSTS=api.arbyte.ir,admin.arbyte.ir
# فقط دامنه‌های خودمان (فروشگاه و پنل).
CORS_ALLOWED_ORIGINS=https://arbyte.ir,https://www.arbyte.ir,https://admin.arbyte.ir
CSRF_TRUSTED_ORIGINS=https://arbyte.ir,https://www.arbyte.ir,https://admin.arbyte.ir,https://api.arbyte.ir
# آدرس فروشگاه (لینک پیامک‌ها، QR کارت گارانتی، فید ترب، sitemap).
FRONTEND_BASE_URL=https://arbyte.ir
# آدرس عمومی همین API (callback درگاه پرداخت).
BACKEND_BASE_URL=https://api.arbyte.ir
# Django admin داخلی (/admin/) — خالی = خاموش. اگر لازم شد مسیر غیرقابل‌حدس، مثل «ops-7f3k/».
DJANGO_ADMIN_URL=

# ── دیتابیس و Redis (داخل شبکه‌ی داکر؛ پورت‌ها بیرون باز نیستند) ─────────────
POSTGRES_DB=arbyte
POSTGRES_USER=arbyte
# تصادفی (setup.sh می‌سازد) — در DATABASE_URL هم همین.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://arbyte:CHANGE_ME@db:5432/arbyte
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ── فروشگاه (Vercel) ↔ این سرور ───────────────────────────────────────────────
# revalidate صفحه‌های فروشگاه بعد از ذخیره در پنل؛ همان مقدار در Vercel.
STOREFRONT_URL=https://arbyte.ir
REVALIDATE_SECRET=
# امضای آی‌پی واقعی کاربر از BFF فروشگاه؛ همان مقدار در Vercel.
BFF_SHARED_SECRET=
# nginx همین سرور X-Real-IP را می‌نویسد → True.
TRUST_X_REAL_IP=True

# ── OTP و پیامک ─────────────────────────────────────────────────────────────
# در تولید حتماً False (با DEBUG=False اجباری است).
OTP_DEV_MODE=False
OTP_LENGTH=4
OTP_REQUEST_PER_MOBILE_LIMIT=3
OTP_REQUEST_PER_MOBILE_WINDOW_MINUTES=10
# کلید API کاوه‌نگار. کلید پنل (تنظیمات → کلیدهای API → کاوه‌نگار) اولویت دارد؛
# این فقط وقتی استفاده می‌شود که در پنل کلید فعالی نباشد.
# قالب‌های arbyteotp / arbyteorder / arbyteadmin / arbyteship باید در کاوه‌نگار تأیید شده باشند.
KAVENEGAR_API_KEY=

# ── تنظیماتی که در پنل‌اند، نه این‌جا (یادآوری) ──────────────────────────────
# • شماره(های) مدیر برای پیامک سفارش تازه (ADMIN_NOTIFY_PHONES):
#     پنل → تنظیمات → اطلاعات فروشگاه → «شماره‌های اعلان» (با کاما جدا).
# • اطلاعات کارت‌به‌کارت (نام صاحب حساب، شماره کارت، شبا):
#     پنل → تنظیمات → کارت‌به‌کارت.
# • کلیدهای درگاه (زرین‌پال merchantId، آیدی‌پی، اسنپ‌پی، دیجی‌پی):
#     پنل → تنظیمات → کلیدهای API (رمزشده با FIELD_ENCRYPTION_KEY). بدون کد تازه
#     فعال می‌شوند؛ آزمون: `docker compose ... exec web python manage.py payment_sandbox_check zarinpal`.
# • کد نماد اعتماد (اینماد): پنل → تنظیمات → اطلاعات فروشگاه.

# ── امنیت ───────────────────────────────────────────────────────────────────
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
# نرخ‌ها (DRF: تعداد/second|min|hour|day) — به ازای آی‌پی واقعی کاربر.
OTP_REQUEST_PER_IP_RATE=10/hour
OTP_VERIFY_RATE=20/hour
ADMIN_LOGIN_RATE=10/min
CONTACT_FORM_RATE=5/hour
ORDER_TRACK_RATE=10/hour
RECEIPT_UPLOAD_RATE=10/hour
PUBLIC_API_RATE=100/min
PAGEVIEW_RATE=120/min
REDIRECT_HIT_RATE=120/min

# ── سفارش ───────────────────────────────────────────────────────────────────
# لغو خودکار سفارش پرداخت‌نشده بعد از این چند ساعت.
ORDER_AUTO_CANCEL_AFTER_HOURS=24

# ── ظرفیت ───────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# ── بک‌آپ (deploy/backup.sh) ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
# اختیاری: کپی بیرون از سرور (S3 سازگار، مثلاً آروان). خالی = فقط محلی.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
