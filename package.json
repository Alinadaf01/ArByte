{
  "name": "arbyte",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @arbyte/api db:generate",
    "db:migrate": "pnpm --filter @arbyte/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @arbyte/api db:migrate:deploy",
    "db:seed": "pnpm --filter @arbyte/api db:seed",
    "db:studio": "pnpm --filter @arbyte/api db:studio",
    "be:dev": "node scripts/backend.mjs python manage.py runserver 8000",
    "be:test": "node scripts/backend.mjs python manage.py test",
    "be:migrate": "node scripts/backend.mjs python manage.py migrate",
    "be:lint": "node scripts/backend.mjs ruff check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
