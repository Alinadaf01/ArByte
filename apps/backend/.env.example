DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Same docker-compose Postgres as the rest of the monorepo
# (infra/docker/docker-compose.dev.yml, host port 5435), separate database
# (arbyte_dj) from Nest's own `arbyte` database.
DATABASE_URL=postgres://arbyte:arbyte@localhost:5435/arbyte_dj

REDIS_URL=redis://localhost:6379/0

# apps/web (3000) and apps/admin (3001) dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Fernet key for ApiCredential.credentials — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

JWT_SIGNING_KEY=change-me-in-production

# Kavenegar (OTP SMS) — key itself should move to ApiCredential once
# apps.settings is wired up in D-04/D-05; kept here only as a local-dev
# fallback.
KAVENEGAR_API_KEY=

# D-04 §۱ — کد OTP را در لاگ سرور می‌نویسد و پیامک واقعی نمی‌فرستد. اگر
# DEBUG=False باشد و این true بماند، سرور بالا نمی‌آید (config/settings.py).
OTP_DEV_MODE=True

# E-02 §۵ — کد ثابت dev برای e2e (Playwright)/تست دستی، بدون scrape کردن
# لاگ سرور برای کد تصادفی. فقط وقتی OTP_DEV_MODE=True مؤثر است.
OTP_DEV_FIXED_CODE=1234

# E-03 §۱.۳ — اطلاعات مقصد کارت‌به‌کارت؛ manage.py seed_arbyte اینها را به
# SiteSettings.card_to_card_* می‌برد (فقط اگر خالی باشد). هرگز مقدار واقعی
# اینجا (.env.example) نگذارید — فقط در .env محلی.
BALEPAY_CARD_NUMBER=
STORE_BANK_SHEBA=
STORE_BANK_OWNER=

# E-03 §۲ — شماره(های) مدیر برای پیامک «سفارش تازه» (چندتایی با کاما).
ADMIN_NOTIFY_PHONES=

# D-04 §۱ — packages/contracts/src/common/rate-limits.ts's otpRequestPerIp/
# otpRequestPerMobile؛ پیش‌فرض‌ها همان مقادیر قرارداد است، از env override می‌شود.
OTP_REQUEST_PER_IP_RATE=10/hour
OTP_REQUEST_PER_MOBILE_LIMIT=3
OTP_REQUEST_PER_MOBILE_WINDOW_MINUTES=10
