# آدرس عمومی خود پنل ادمین
NEXT_PUBLIC_APP_URL=http://localhost:3001

# آدرس پایه‌ی API — از همان مبدأ خودِ پنل (نه پورت جدای apps/api)؛
# next.config.ts با rewrites این مسیر را سمت سرور به API واقعی پروکسی می‌کند
# تا مرورگر هرگز نیازی به CORS/مبدأ دیگر نداشته باشد.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# آدرس داخلی apps/api که next.config.ts سمت سرور به آن پروکسی می‌کند (کلاینت هرگز مستقیم آن را نمی‌بیند).
API_INTERNAL_URL=http://localhost:4000
