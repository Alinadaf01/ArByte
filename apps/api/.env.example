# ==============================================================================
# apps/api — متغیرهای محیطی
# طبق بند ۱۲.۱۳ برند بوک: هر متغیر با هدف، اجباری/اختیاری بودن و نمونه مستند است.
# طبق بند ۱۱.۱۰۸: هیچ Secret واقعی نباید اینجا یا در Git باشد — فقط نمونه.
# اگر یکی از متغیرهای اجباری در .env غایب باشد، اپ در بوت با خطای واضح fail می‌کند
# (ر.ک. src/config/env.validation.ts).
# ==============================================================================

# --- APP ----------------------------------------------------------------------
# محیط اجرا. الزامی. یکی از: development | test | production
NODE_ENV=development

# پورتی که NestJS روی آن گوش می‌دهد. اختیاری، پیش‌فرض 4000.
APP_PORT=4000

# آدرس عمومی خود API (برای CORS، لینک‌های SMS و غیره). الزامی.
APP_URL=http://localhost:4000

# --- DATABASE (PostgreSQL 16) --------------------------------------------------
# Connection string کامل Postgres. الزامی.
# نمونه: postgres://user:password@localhost:5432/arbyte
DATABASE_URL=postgres://arbyte:arbyte@localhost:5432/arbyte

# --- REDIS ----------------------------------------------------------------------
# میزبان Redis. الزامی.
REDIS_HOST=localhost
# پورت Redis. اختیاری، پیش‌فرض 6379.
REDIS_PORT=6379
# رمز Redis. اختیاری (در محیط dev معمولاً خالی).
REDIS_PASSWORD=

# --- S3 / MinIO (Object Storage — بند ۸.۸۹) -------------------------------------
# آدرس endpoint سرویس سازگار با S3. الزامی.
S3_ENDPOINT=http://localhost:9000
# ریجن. اختیاری، پیش‌فرض us-east-1 (برای MinIO محلی معنایی ندارد ولی SDK آن را می‌خواهد).
S3_REGION=us-east-1
# نام باکت پیش‌فرض. الزامی.
S3_BUCKET=arbyte-media
# کلید دسترسی. الزامی.
S3_ACCESS_KEY_ID=arbyte
# کلید مخفی. الزامی — هرگز مقدار پیش‌فرض/نمونه در Production استفاده نشود.
# باید با MINIO_ROOT_PASSWORD در infra/docker/docker-compose.dev.yml یکی باشد.
S3_SECRET_ACCESS_KEY=arbyte-minio-dev-secret

# --- JWT (Access + Refresh — بند ۱۱.۷) ------------------------------------------
# رشته‌ی تصادفی حداقل ۳۲ کاراکتر. الزامی. هرگز مقدار پیش‌فرض/نمونه‌ی این فایل استفاده نشود.
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
# مدت اعتبار توکن‌ها. اختیاری.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- KAVENEGAR (SMS Provider — بند ۸.۷۲) -----------------------------------------
# کلید API کاوه‌نگار. الزامی.
KAVENEGAR_API_KEY=replace-with-real-kavenegar-api-key

# --- FEATURE FLAGS (بند ۱۲.۶۳، ۱۲.۸۷) --------------------------------------------
# منبع خواندن پرچم‌ها در زمان اجرا. اختیاری، پیش‌فرض memory تا زمانی که T-003
# جدول Settings را بسازد و مقدار database فعال شود.
FEATURE_FLAGS_SOURCE=memory
