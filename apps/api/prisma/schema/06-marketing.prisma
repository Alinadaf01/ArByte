// تخفیف و بازاریابی — بندهای §۸.۵۷ تا §۸.۶۰، به‌علاوه‌ی سند مقایسه‌ی وایب‌شاپ
// (HomepageBlock، بخش ۲.۱).

/// §۸.۵۷ فقط «Type» گفته؛ دو نوع استاندارد (تصمیم T-003).
enum CouponType {
  PERCENT
  AMOUNT
}

/// §۸.۵۷، §۸.۵۸.
model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique
  type                  CouponType
  /// تصمیم T-003-DECISION — همان الگوی PriceRule (type الزامی، پس CHECK
  /// دو حالت دارد، نه سه).
  amountToman           BigInt?
  percentBasisPoints    Int?
  minimumOrderAmount    BigInt?
  maximumDiscountAmount BigInt?
  usageLimit            Int?
  perUserLimit          Int?
  startDate             DateTime?
  endDate               DateTime?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  usages CouponUsage[]
}

/// برای Enforce کردن usageLimit/perUserLimit لازم است — هر استفاده یک ردیف.
model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String
  discountAmount BigInt
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([userId])
}

/// §۸.۵۹، §۸.۶۰ — priority برای حل تداخل چند تخفیف هم‌زمان (تصمیم T-003: بدون
/// enum وضعیت جدا، isActive + startAt/endAt کافی است — همان الگوی
/// HomepageBlock پایین‌تر).
model Campaign {
  id        String   @id @default(cuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  /// ساختار Rule استاندارد نشده در برند بوک — Json آزاد (تصمیم T-003).
  rules     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CampaignProduct[]
}

/// کمپین می‌تواند Product *یا* Category را هدف بگیرد — دقیقاً یکی ست است.
model CampaignProduct {
  id         String  @id @default(cuid())
  campaignId String
  productId  String?
  categoryId String?

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([productId])
  @@index([categoryId])
}

/// سند مقایسه‌ی وایب‌شاپ، بخش ۲.۱ — مدیریت محتوای صفحه‌ی اصلی؛ بدون این،
/// هر تغییر صفحه‌ی اصلی یعنی دیپلوی مجدد.
enum HomepageBlockType {
  HERO
  CATEGORY_GRID
  PRODUCT_RAIL
  CAMPAIGN
  BENEFITS
  BLOG_RAIL
}

model HomepageBlock {
  id           String            @id @default(cuid())
  type         HomepageBlockType
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  title        String?
  subtitle     String?
  ctaLabel     String?
  ctaUrl       String?
  imageDesktop String?
  imageMobile  String?
  /// §۱۰.۵۴ Image SEO — جدا گرفته شده، الزامی طبق سند مقایسه.
  imageAlt     String?
  /// پارامترهای مخصوص هر نوع بلوک (مثلاً کدام محصولات در PRODUCT_RAIL).
  config       Json?
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type, sortOrder])
}
