// موجودی و تراکنش موجودی — بندهای §۷.۳۷ تا §۷.۳۹، §۸.۳۰ تا §۸.۳۴، به‌علاوه‌ی
// سند مقایسه‌ی وایب‌شاپ (lowStockThreshold قابل override per-محصول).
//
// T-149: مدل مکان‌محور الحاقیه‌ی T-003 (بخش ۳) حذف شد — یک برچسب متنی در
// طراحی بود، نه نیاز واقعی؛ دفتر کل `InventoryTransaction` کافی است.
// جزئیات در docs/data-model.md و docs/design/storefront/DEVIATIONS.md.

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

/// §۸.۳۰، §۸.۳۱ — کلید یکتا روی variantId (T-149: بدون بُعد مکان). `version`
/// برای Optimistic Locking (قاعده‌ی فنی #۳، §۸.۸۳). `lowStockThreshold` نال
/// یعنی پیش‌فرض سراسری Setting اعمال شود (سند مقایسه‌ی وایب‌شاپ، بخش ۲.۴).
///
/// ⚠️ `availableQuantity` در دیتابیس واقعی یک ستون
/// `GENERATED ALWAYS AS ("quantity" - "reservedQuantity") STORED` است (§۸.۳۱:
/// ستون محاسباتی/view، نه محاسبه در اپلیکیشن). عمداً بدون `@default` و
/// nullable نوشته شده تا Prisma Client هرگز مقداری برایش در INSERT/UPDATE
/// نفرستد — فرستادن هر مقداری (حتی ۰ پیش‌فرض) را Postgres رد می‌کند چون ستون
/// واقعاً GENERATED است. هیچ‌جای کد نباید صریح این فیلد را ست کند؛ جزئیات در
/// docs/data-model.md.
model Inventory {
  variantId         String   @id
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  availableQuantity Int?
  lowStockThreshold Int?
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

/// §۸.۳۳، §۸.۳۴ (کاردکس) — روی variantId. موجودی هرگز مستقیم UPDATE
/// نمی‌شود؛ هر تغییر یک ردیف اینجا هم می‌سازد.
model InventoryTransaction {
  id             String                   @id @default(cuid())
  variantId      String
  type           InventoryTransactionType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  userId         String?
  reference      String?
  note           String?
  createdAt      DateTime                 @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}
