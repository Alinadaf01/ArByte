// سیستم — بندهای §۸.۶۹ تا §۸.۸۱، §۷.۴۰ تا §۷.۴۶، §۱۱.۳۵ تا §۱۱.۳۶، به‌علاوه‌ی
// سند مقایسه‌ی وایب‌شاپ (ImpersonationTicket بخش ۲.۲، DailyStat بخش ۲.۶).

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

/// §۸.۷۰ — `type` عمداً String است نه enum: رویدادهای سیستم باز و رو به
/// رشدند (Order Created، Payment Confirmed، ...)؛ enum یعنی migration به ازای
/// هر رویداد جدید، که با روح Extensible بودن این بخش (§۸.۷۱/۷۲) نمی‌خواند.
model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

/// §۸.۷۱ — Templateهای قابل مدیریت با Placeholder مثل {order_number}.
model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String              @unique
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

/// §۸.۷۳، §۸.۷۴ — ماژولار، Enabled/Disabled. ⚠️ `config` فقط برای مقادیر
/// غیرحساس است — API Key/Secret طبق §۸.۷۵ در env variable می‌مانند، نه اینجا
/// (همان الگوی apps/api/.env.example از T-000).
model Integration {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isEnabled Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// §۸.۷۶ — Key-Value ساختارمند؛ گروه‌بندی با `category`. کلیدهای اقساط
/// الحاقیه (installments.enabled/maxCount/minAmount/provider) و آستانه‌ی
/// سراسری موجودی کم (سند مقایسه‌ی وایب‌شاپ) اینجا زندگی می‌کنند.
model Setting {
  key       String   @id
  value     Json
  category  String?
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// §۸.۷۷، §۸.۷۸ — ⚠️ Immutable در سطح دیتابیس: تریگر UPDATE/DELETE را رد
/// می‌کند (migration دستی، ر.ک. docs/data-model.md). به همین دلیل هم
/// updatedAt ندارد — هیچ ردیفی هرگز UPDATE نمی‌شود.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
}

/// §۸.۷۹ فقط «Status» گفته؛ چهار حالت متعارف Job (تصمیم T-003).
enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportJobRowStatus {
  SUCCESS
  FAILED
  SKIPPED
}

/// §۷.۴۰ تا §۷.۴۶، §۸.۷۹، §۱۱.۳۵–۳۶.
model ImportJob {
  id              String          @id @default(cuid())
  fileUrl         String
  status          ImportJobStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  totalRows       Int             @default(0)
  successfulRows  Int             @default(0)
  failedRows      Int             @default(0)
  createdByUserId String?
  createdAt       DateTime        @default(now())

  createdBy User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows      ImportJobRow[]

  @@index([createdByUserId])
}

/// §۸.۸۰ Idempotency — `skuMatched` تشخیص می‌دهد این ردیف محصول موجود را
/// آپدیت کرده یا محصول جدید ساخته، تا Import مجدد Duplicate نسازد.
model ImportJobRow {
  id           String             @id @default(cuid())
  importJobId  String
  rowNumber    Int
  status       ImportJobRowStatus
  skuMatched   String?
  errorMessage String?
  rawData      Json?

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

/// §۸.۸۹ — فایل واقعی در Object Storage/CDN می‌ماند؛ اینجا فقط Metadata.
/// توجه: ProductImage/تصاویر Category عمداً مستقیم url دارند (فیلدهای
/// مشخص §۸.۲۰/۷.۲۸)، نه از طریق این جدول — MediaAsset برای آپلودهای عمومی
/// (Import، رسید پرداخت، تصاویر بلاگ/HomepageBlock در صورت نیاز) است.
model MediaAsset {
  id               String   @id @default(cuid())
  url              String
  mimeType         String?
  sizeBytes        Int?
  altText          String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

/// §۸.۱۷ — تغییر Slug باید Redirect از URL قبلی داشته باشد تا SEO آسیب نبیند.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

/// سند مقایسه‌ی وایب‌شاپ، بخش ۲.۶ — آمار روزانه‌ی تجمیعی تا داشبورد ادمین کند
/// نشود. پرشدن با Scheduled Job در فاز بعد؛ اینجا فقط شکل جدول.
model DailyStat {
  id               String   @id @default(cuid())
  date             DateTime @unique @db.Date
  orderCount       Int      @default(0)
  revenueTotal     BigInt   @default(0)
  newCustomerCount Int      @default(0)
  visitCount       Int      @default(0)
}

/// سند مقایسه‌ی وایب‌شاپ، بخش ۲.۲ — بلیت یک‌بارمصرف با عمر کوتاه (۶۰ ثانیه،
/// در لایه‌ی سرویس Enforce می‌شود)؛ پنل ادمین هرگز JWT واقعی مشتری را نمی‌گیرد.
/// فقط با POST تبادل می‌شود تا در URL/تاریخچه/لاگ/Referer ننشیند.
model ImpersonationTicket {
  id         String    @id @default(cuid())
  adminId    String
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  admin    User @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  customer User @relation("ImpersonationCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}
