// کاتالوگ — بندهای §۷.۹ تا §۷.۳۹، §۸.۱۵ تا §۸.۲۹، §۱۱.۲۹ تا §۱۱.۳۴، به‌علاوه‌ی
// الحاقیه‌ی T-003 (ProductVariant) و سند مقایسه‌ی وایب‌شاپ (swatchHex).
//
// نکته‌ی مهم درباره‌ی slug/sku: این فیلدها اینجا @unique معمولی *نیستند*،
// فقط @@index شده‌اند. یونیک واقعی یک Partial Unique Index است
// (`WHERE "deletedAt" IS NULL`) که در یک migration دستی بعد از اسکیمای اولیه
// اضافه می‌شود (Prisma schema DSL از WHERE در @@unique پشتیبانی نمی‌کند) —
// ر.ک. §۸.۸۱ تله‌ی Soft Delete در T-003-data-model.md.

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// §۷.۱۸ — چهار مقدار فعلی، از Backend قابل مدیریت است اما فعلاً enum کافی است.
enum ProductCondition {
  NEW
  OPEN_BOX
  STOCK
  LIKE_NEW
}

/// §۷.۳۱ — لیست کامل‌تر از پاراگراف خلاصه‌ی T-003-data-model.md (که فقط
/// select/number/text/boolean را نام برده بود)؛ این نسخه‌ی کامل بند ۷.۳۱ است.
enum SpecificationType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  RANGE
  COLOR
  DATE
}

/// §۷.۲۶ تا §۷.۲۹ — self-referencing، عمق نامحدود در دیتابیس (تصمیم ه — UI فعلاً
/// دو سطح نشان می‌دهد).
model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String
  parentId       String?
  description    String?
  imageMain      String?
  imageBanner    String?
  imageThumbnail String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent                   Category?                 @relation("CategoryTree", fields: [parentId], references: [id])
  children                 Category[]                @relation("CategoryTree")
  products                 Product[]
  specificationDefinitions SpecificationDefinition[]
  campaignProducts         CampaignProduct[]
  priceRules               PriceRule[]
  seo                      SeoMetadata?

  @@index([slug])
  @@index([parentId])
}

/// §۸.۱۹ — Entity مستقل برای فیلتر/صفحه/SEO/گزارش برند.
model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
}

/// §۸.۱۵ — موجودیت مرکزی. طبق الحاقیه‌ی T-003: هویت مشترک فقط. قیمت/موجودی/SKU
/// روی ProductVariant است، نه اینجا.
model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String
  brandId             String
  categoryId          String
  /// §۱۰.۶۴–۱۰.۶۸ — فیلدهای لازم فید ترب، حتی اگر فید خودش P1 است.
  modelNumber         String?
  gtin                String?
  partNumber          String?
  description         String?          @db.Text
  shortDescription    String?
  condition           ProductCondition
  status              ProductStatus    @default(ACTIVE)
  /// §۷.۱۴ — چهار حالت نمایش برند بوک با سه فلگ مستقل مدل شده (ترکیب هر سه
  /// false یعنی «فقط در Backend»).
  isVisibleOnSite     Boolean          @default(true)
  isVisibleInSearch   Boolean          @default(true)
  isVisibleInCategory Boolean          @default(true)
  /// §۸.۱۵ فیلد «Return Policy» — متن آزاد؛ شرایط واجدبودن مرجوعی (§۸.۵۳)
  /// منطق جداست، نه این فیلد.
  returnPolicyNote    String?
  /// §۸.۱۵ فیلد «Shipping» — یادداشت آزاد (وزن/ابعاد/کلاس ارسال دقیق‌تر بعداً
  /// در صورت نیاز اضافه می‌شود؛ تصمیم T-003، برند بوک فیلد دقیق نداده).
  shippingNote        String?
  /// §۷.۱۰ «اولویت نمایش» / §۱۱.۳۰ Priority.
  priority            Int              @default(0)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  brand            Brand                  @relation(fields: [brandId], references: [id])
  category         Category               @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  specifications   ProductSpecification[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  campaignProducts CampaignProduct[]
  seo              SeoMetadata?

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

/// الحاقیه‌ی T-003، بخش ۱ — هر Product حداقل یک Variant دارد (محصول بدون
/// پیکربندی = یک واریانت پیش‌فرض، تا کد شاخه‌ی «دارد/ندارد» نداشته باشد).
model ProductVariant {
  id                       String      @id @default(cuid())
  productId                String
  sku                      String
  /// نام قابل‌نمایش پیکربندی، مثلاً «۶۴GB · ۲TB» — دقیقاً همین رشته در
  /// OrderItem اسنپ‌شات می‌شود (الحاقیه، بند ۱، هشدار).
  name                     String?
  isDefault                Boolean     @default(false)
  priceModel               PriceModel  @default(FIXED)
  supplierPrice            BigInt?
  profitType               ProfitType?
  /// تصمیم T-003-DECISION: یک ستون دوگانه (Decimal که معنایش به profitType
  /// وابسته بود) قبلاً همین‌جا بود — مشکل واقعی‌اش دقت‌نداشتن Decimal نبود،
  /// این بود که معنا به ستون دیگری وابسته بود و هیچ CHECK معناداری
  /// نمی‌شد رویش گذاشت. حالا دو ستون تک‌معنا + CHECK (در migration) —
  /// دقیقاً یکی از این دو (یا هیچ‌کدام، اگر profitType هم null باشد) باید
  /// ست باشد. واحد Toman است (نه Rial) — همان‌طور که در کل اسکیما استفاده
  /// می‌شود، ر.ک. docs/data-model.md.
  profitAmountToman        BigInt?
  /// ۸٪ = 800 (بدون اعشار) — نه ٪ خام، تا هیچ ابهامی در دقت نباشد.
  profitPercentBasisPoints Int?
  /// §۸.۴۰ — ذخیره‌شده، نه محاسبه‌ی لحظه‌ای (فید ترب + ایندکس جستجو).
  finalPrice               BigInt
  /// §۷.۱۰ «قیمت قبلی» — برای نمایش تخفیف خط‌خورده.
  compareAtPrice           BigInt?
  /// §۱۱.۵۵/۱۲.۸۸ اقساط — فقط شکل داده، بدون منطق (الحاقیه بخش ۲).
  installmentEligible      Boolean     @default(false)
  maxInstallments          Int?
  deletedAt                DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  supplierProducts      SupplierProduct[]
  priceHistory          PriceHistory[]
  specifications        ProductSpecification[]
  wishlistItems         WishlistItem[]

  @@index([sku])
  @@index([productId])
}

/// §۸.۲۳، §۷.۳۰ — تعریف یک مشخصه؛ الحاقیه: isVariantAxis مشخص می‌کند این
/// مشخصه پیکربندی‌ها را از هم جدا می‌کند (RAM/Storage) یا نه.
model SpecificationDefinition {
  id            String            @id @default(cuid())
  key           String            @unique
  nameFa        String
  type          SpecificationType
  /// §۸.۲۷ — واحد جدا از مقدار (GB/TB/inch/Hz/kg/W).
  unit          String?
  categoryId    String?
  isRequired    Boolean           @default(false)
  /// §۷.۳۵
  isFilterable  Boolean           @default(false)
  /// §۷.۳۶
  isSearchable  Boolean           @default(false)
  /// الحاقیه‌ی T-003، بخش ۱.
  isVariantAxis Boolean           @default(false)
  sortOrder     Int               @default(0)

  category              Category?              @relation(fields: [categoryId], references: [id])
  values                SpecificationValue[]
  productSpecifications ProductSpecification[]

  @@index([categoryId])
}

/// §۸.۲۵ — مقادیر از پیش تعریف‌شده؛ swatchHex برای مشخصات نوع COLOR (سند
/// مقایسه‌ی وایب‌شاپ، بخش ۲.۳).
model SpecificationValue {
  id                        String  @id @default(cuid())
  specificationDefinitionId String
  value                     String
  swatchHex                 String?
  sortOrder                 Int     @default(0)

  definition            SpecificationDefinition @relation(fields: [specificationDefinitionId], references: [id], onDelete: Cascade)
  productSpecifications ProductSpecification[]

  @@index([specificationDefinitionId])
}

/// §۸.۲۲، §۸.۲۶، §۸.۲۸ — اتصال به Product *یا* ProductVariant (دقیقاً یکی
/// پر است؛ مشخصات مشترک روی Product، مشخصات‌محور-واریانت روی ProductVariant
/// — الحاقیه، بخش ۱). numericValue برای فیلتر بازه‌ای (§۸.۲۸)، customValue
/// برای مقدار خارج از لیست (§۸.۲۶).
model ProductSpecification {
  id                        String   @id @default(cuid())
  specificationDefinitionId String
  specificationValueId      String?
  customValue               String?
  /// تک‌معناست (همیشه «عدد خام مشخصه»، نه دوگانه به یک ستون دیگر وابسته)،
  /// پس طبق T-003-DECISION در استثنای Decimal می‌ماند — نیاز واقعی به
  /// اعشار دارد (مثلاً اندازه‌ی صفحه‌نمایش ۱۶٫۱ اینچ).
  numericValue              Decimal? @db.Decimal(14, 4)
  productId                 String?
  variantId                 String?

  definition SpecificationDefinition @relation(fields: [specificationDefinitionId], references: [id], onDelete: Cascade)
  value      SpecificationValue?     @relation(fields: [specificationValueId], references: [id])
  product    Product?                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([specificationDefinitionId, numericValue])
  @@index([productId])
  @@index([variantId])
}

/// §۸.۲۰، §۸.۲۱ — جدا از Product اصلی، ترتیب‌دار، فقط یک تصویر Primary.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
