// کاربر و دسترسی — بندهای §۸.۴ تا §۸.۱۴، §۱۱.۲۹.

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// §۸.۴ — شماره موبایل شناسه‌ی یکتا و اصلی احراز هویت است (§۸.۵، بدون رمز عبور).
model User {
  id          String     @id @default(cuid())
  mobile      String     @unique
  firstName   String?
  lastName    String?
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  /// §۸.۸۱ Soft Delete — کاربر صراحتاً در فهرست موجودیت‌های نرم‌حذف‌شدنی است.
  deletedAt   DateTime?

  addresses             UserAddress[]
  roles                 UserRole[]
  sessions              Session[]
  otpRequests           OtpRequest[]
  cart                  Cart?
  orders                Order[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  notifications         Notification[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  importJobs            ImportJob[]
  impersonationTickets  ImpersonationTicket[]  @relation("ImpersonationCustomer")
  impersonationsAsAdmin ImpersonationTicket[]  @relation("ImpersonationAdmin")
  priceHistoryChanges   PriceHistory[]
  inventoryTransactions InventoryTransaction[]
  orderStatusChanges    OrderStatusHistory[]
  uploadedReceipts      PaymentReceipt[]       @relation("ReceiptUploader")
  reviewedReceipts      PaymentReceipt[]       @relation("ReceiptReviewer")
  couponUsages          CouponUsage[]
  blogPosts             BlogPost[]
  mediaAssets           MediaAsset[]

  @@index([mobile])
}

/// §۸.۸، §۸.۹ — چند آدرس در هر کاربر، دقیقاً یکی Default (پارشال یونیک ایندکس
/// در migration، ر.ک. docs/data-model.md).
model UserAddress {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  mobile        String
  province      String
  city          String
  addressLine   String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

/// §۸.۱۰ — مجموعه‌ای از Permissionها.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

/// §۸.۱۱ — Granular، مثل products.view/products.create/... به‌علاوه‌ی
/// users.impersonate (سند مقایسه‌ی وایب‌شاپ، بخش ۵).
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

/// §۸.۱۲ — Many-to-Many.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// §۸.۱۳ — یک کاربر می‌تواند چند Role داشته باشد.
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// §۸.۵، §۸.۶ — OTP هرگز plain-text دائمی ذخیره نمی‌شود (فقط hash)، یک‌بارمصرف،
/// Rate Limit با ایندکس mobile+createdAt.
model OtpRequest {
  id           String    @id @default(cuid())
  userId       String?
  mobile       String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, createdAt])
}

/// §۸.۷ — Session/Token بعد از تأیید OTP؛ قابل Expiration/Logout/Revocation.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
