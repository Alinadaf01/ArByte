// سبد، سفارش، پرداخت، ارسال، مرجوعی — بندهای §۸.۴۱ تا §۸.۵۵، §۷.۴۸، §۷.۴۹،
// §۸.۴۶ تا §۸.۵۳، §۱۱.۵۰ تا §۱۱.۵۵، به‌علاوه‌ی الحاقیه‌ی T-003 (بخش ۴، انتزاع
// درگاه پرداخت) و سند مقایسه‌ی وایب‌شاپ (بخش ۶، ماشین‌حالت وضعیت سفارش).
//
// ⚠️ ماشین‌حالت گذارهای مجاز OrderStatus عمداً اینجا کد نمی‌شود — طبق محدودیت
// T-003 («هیچ منطق کسب‌وکاری در این تسک»)؛ جدول گذارهای مجاز در
// docs/data-model.md مستند شده تا T-004 آن را Enforce کند.

/// تصمیم الف (T-003-data-model.md) — لیست نهاییِ سازگارشده‌ی §۷.۴۸/§۱۱.۵۰/§۲.۳۷.
/// RETURNED عمداً حذف شده: مرجوعی موجودیت جداست (§۸.۵۲)، سفارش می‌تواند
/// DELIVERED باشد و فقط یک قلمش مرجوع شود. این enum دقیقاً با
/// packages/contracts/src/messages/order.ts `orderStatus` منطبق است.
enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

/// §۷.۴۹ — مستقل از OrderStatus (تصمیم ب، §۸.۴۵).
enum PaymentStatus {
  UNPAID
  RECEIPT_UPLOADED
  UNDER_REVIEW
  CONFIRMED
}

/// الحاقیه‌ی T-003، بخش ۴ — در نسخه‌ی فعلی فقط Card to Card (§۸.۴۶)، اما
/// انتزاع از روز اول برای درگاه.
enum PaymentMethod {
  MANUAL_CARD_TO_CARD
  GATEWAY
}

enum PaymentProvider {
  NONE
  BALEPAY
}

/// §۸.۴۷/۸.۴۸ — برند بوک فقط «Status» گفته، مقادیر را مشخص نکرده؛ این سه‌حالت
/// (تصمیم T-003) با فیلدهای Reviewed By/At/Rejection Reason هم‌خوان است.
enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

/// §۸.۵۲ فقط «Status» گفته؛ این جریان استاندارد مرجوعی تصمیم T-003 است، نه
/// نقل‌قول مستقیم برند بوک — دقیقاً با packages/contracts `returnStatus` یکی.
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

/// §۸.۵۴ — یک Cart فعال برای هر کاربر. `sessionId` تصمیم T-003 است (برند بوک
/// چیزی درباره‌ی سبد مهمان نگفته، اما هم رد نکرده؛ اکثر تعامل پیش از OTP
/// اتفاق می‌افتد) — دقیقاً یکی از userId/sessionId باید ست باشد.
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

/// §۸.۵۴ — Product+Quantity؛ `unitPriceSnapshot` فقط برای نمایش سریع سبد است،
/// قیمت واقعی همیشه هنگام Checkout از سرور بازخوانی می‌شود (§۸.۵۵).
model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  variantId         String
  quantity          Int
  unitPriceSnapshot BigInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

/// §۸.۴۱، §۸.۴۲ — شماره سفارش خوانا (ARB-YYYY-NNNNNN) جدا از ID داخلی.
/// آدرس هم به‌صورت Snapshot در خود Order کپی می‌شود (تصمیم T-003 — تعمیم
/// همان اصل Price Snapshot §۸.۴۰/۸.۴۴ به آدرس، چون آدرس کاربر ممکن است
/// بعداً ویرایش/حذف شود ولی سفارش قدیمی نباید عوض شود).
model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  addressId     String?
  status        OrderStatus   @default(PENDING)
  /// تصمیم ب — منبع حقیقت پرداخت Payment.status است؛ این فیلد هرگز مستقیم
  /// از پرداخت ست نمی‌شود، بلکه توسط سرویس‌لایه (T-004) از آن مشتق و
  /// synchronize می‌شود.
  paymentStatus PaymentStatus @default(UNPAID)

  shippingRecipientName String
  shippingMobile        String
  shippingProvince      String
  shippingCity          String
  shippingAddressLine   String
  shippingPostalCode    String?

  subtotal      BigInt
  discountTotal BigInt   @default(0)
  shippingCost  BigInt   @default(0)
  finalTotal    BigInt
  /// تصمیم ج — دلیل لغو، مثلاً "PAYMENT_TIMEOUT" (Scheduled Job رزرو منقضی).
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  address       UserAddress?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipment      Shipment?
  returns       Return[]
  couponUsages  CouponUsage[]
  reviews       Review[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

/// §۸.۴۳، §۸.۴۴ — Snapshot کامل؛ `variantId` عمداً nullable (الحاقیه، هشدار):
/// اگر واریانت بعداً حذف شد، سفارش قدیمی باید هنوز بگوید مشتری چه خریده.
model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  variantId           String?
  productNameSnapshot String
  variantNameSnapshot String?
  skuSnapshot         String
  /// مشخصات کلیدی در لحظه‌ی خرید (الحاقیه) — بلاک JSON، نه رابطه‌ی زنده به
  /// ProductSpecification که ممکن است بعداً تغییر کند.
  specSnapshot        Json?
  unitPrice           BigInt
  quantity            Int
  discount            BigInt   @default(0)
  finalPrice          BigInt
  createdAt           DateTime @default(now())

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

/// §۱۱.۵۱ — هر تغییر وضعیت سفارش ثبت می‌شود.
model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/// §۸.۴۶ + الحاقیه بخش ۴ — انتزاع درگاه؛ هیچ منطق درگاهی اینجا نیست، فقط شکل
/// داده. `providerPayload` باید پیش از ذخیره از داده‌ی حساس (شماره کارت کامل،
/// CVV، توکن) پاک شود — این اسکراب در لایه‌ی سرویس (T-004) انجام می‌شود، نه اینجا.
model Payment {
  id              String          @id @default(cuid())
  orderId         String
  method          PaymentMethod
  provider        PaymentProvider @default(NONE)
  status          PaymentStatus   @default(UNPAID)
  amount          BigInt
  providerRef     String?
  providerPayload Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receipts PaymentReceipt[]

  @@index([orderId])
}

/// §۸.۴۷، §۸.۴۸ — رسید پرداخت دستی، Entity مستقل.
model PaymentReceipt {
  id               String        @id @default(cuid())
  paymentId        String
  userId           String
  fileUrl          String
  amount           BigInt
  uploadedAt       DateTime      @default(now())
  status           ReceiptStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user       User    @relation("ReceiptUploader", fields: [userId], references: [id])
  reviewedBy User?   @relation("ReceiptReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

/// §۸.۴۹ تا §۸.۵۱ — یک Order یک Shipment (بدون مرسوله‌ی چندتکه؛ برند بوک
/// چنین حالتی را توصیف نکرده). عمداً فیلد Status جدا ندارد — SHIPPED/DELIVERED
/// همین حالا در OrderStatus هست؛ فیلد سوم یعنی نقض اصل Single Source of Truth
/// که تصمیم ب برای Order/Payment گرفت، همان استدلال اینجا هم تعمیم داده شده.
model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  provider       String
  cost           BigInt    @default(0)
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// §۸.۵۲ — به Order متصل؛ آیتم‌های مشمول از طریق ReturnItem (چون سفارش
/// می‌تواند فقط جزئاً مرجوع شود — همان استدلالی که RETURNED را از OrderStatus
/// حذف کرد). `imageUrls` آرایه‌ی ساده‌ی Postgres، نه یک مدل جدا برای این حجم کم.
model Return {
  id          String       @id @default(cuid())
  orderId     String
  reason      String
  description String?
  status      ReturnStatus @default(REQUESTED)
  imageUrls   String[]     @default([])
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([orderId])
}

/// اتصال Return↔OrderItem با تعداد (ممکن است فقط بخشی از تعداد سفارش‌شده
/// مرجوع شود).
model ReturnItem {
  id          String @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
}
