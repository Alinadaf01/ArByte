// محتوا و تعامل — بندهای §۸.۵۶ تا §۸.۶۸.

/// §۸.۶۲ — Pending → Approved صریح است؛ Rejected افزوده‌ی منطقی T-003 است.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// §۸.۶۴ فقط «Status» گفته؛ جریان استاندارد فرم تماس (تصمیم T-003).
enum MessageStatus {
  NEW
  READ
  REPLIED
}

/// §۸.۶۶ — Draft تا Publish در Frontend نمایش داده نمی‌شود.
enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

/// §۸.۶۱ تا §۸.۶۳.
model Review {
  id                 String       @id @default(cuid())
  userId             String
  productId          String
  orderId            String?
  rating             Int
  text               String?      @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
}

/// §۸.۵۶ — یک رابطه‌ی ساده‌ی User↔Product است، نیازی به مدل «Wishlist»ی جدا
/// به‌عنوان ظرف نیست (تصمیم T-003، ر.ک. docs/data-model.md). `variantId`
/// اختیاری طبق الحاقیه: «اگر واریانت انتخاب شده بود، نگه دار».
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
}

/// §۸.۶۴ — پیام تماس با ما.
model Message {
  id        String        @id @default(cuid())
  name      String
  mobile    String
  email     String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
}

/// §۸.۶۵.
model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  /// بدون Soft Delete (پایین‌تر توضیح داده شده)، پس @unique معمولی کافی است —
  /// نیازی به پارشال ایندکس دستی نیست.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

/// §۸.۶۵ تا §۸.۶۷.
model BlogPost {
  id            String         @id @default(cuid())
  title         String
  /// بدون Soft Delete (§۸.۸۱ فقط Product/User/Category را مثال زده) —
  /// @unique معمولی کافی است.
  slug          String         @unique
  content       String         @db.Text
  featuredImage String?
  categoryId    String?
  authorId      String?
  status        BlogPostStatus @default(DRAFT)
  /// §۸.۶۷ — محتوای AI بدون تأیید انسانی منتشر نمی‌شود؛ این فلگ فقط منشأ را
  /// ردیابی می‌کند، خودِ اجرای این قاعده منطق سرویس (T-004) است.
  isAiGenerated Boolean        @default(false)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seo      SeoMetadata?

  @@index([categoryId])
}

/// §۸.۶۸ — یک شکل مشترک، چهار مالک ممکن (Category/Brand/Product/BlogPost)، دقیقاً
/// یکی از چهار FK ست است (هر چهار @unique تا رابطه‌ی یک‌به‌یک باشد).
/// brandId در T-101 اضافه شد — سند فاز ۱ برای Brand صریحاً «فیلدهای سئو»
/// خواسته بود ولی این مدل تا این تسک آن را نداشت (شکاف واقعی، نه تصمیم).
model SeoMetadata {
  id              String  @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonical       String?
  robots          String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  categoryId      String? @unique
  brandId         String? @unique
  productId       String? @unique
  blogPostId      String? @unique

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  blogPost BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}
