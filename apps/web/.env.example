# آدرس عمومی خود فرانت (برای canonical/sitemap و غیره) — بند ۱۰.۷۱
NEXT_PUBLIC_APP_URL=http://localhost:3000

# آدرس پایه‌ی API — بند ۱۱.۶ (Versioning شامل /api/v1 در خود پایه یا مسیر است)
# D-03 — Django (apps/backend)، نه Nest (apps/api). Nest همچنان روی پورت
# ۴۰۰۰ در دسترس است (خاموش نشده، فقط دیگر استفاده نمی‌شود؛ حذفش بچ ۰۴ است).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# آدرس داخلی apps/backend برای فراخوانی‌های سمت سرور (RSC) — بدون NEXT_PUBLIC_
# چون مرورگر هرگز مستقیم آن را نمی‌بیند (T-200، ر.ک. src/lib/catalog.ts).
API_INTERNAL_URL=http://localhost:8000/api/v1
